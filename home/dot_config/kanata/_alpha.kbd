;; ==============================================================
;; Alpha / Plain / Chars module
;; Included by config.kbd via (include alpha.kbd).
;; ==============================================================
;; Contains:
;;   - chord aliases : pl_* + al_*
;;   - chord groups  : defchords CH_PL, CH_AL
;;   - layers        : L_ALPHA (base), L_PLAIN, L_CHARS
;;
;; Resolved via kanata global namespace:
;;   needs var     : chord_timeout (defvar in config.kbd)
;;   needs aliases : al_nav_a al_nav_semicolon
;;                   os_go os_nums os_media os_ff
;;   provides      : layer names L_ALPHA / L_PLAIN / L_CHARS

(defalias
  ;; SWITCH TO
  sw_al         (layer-switch L_ALPHA)
  sw_plain      (layer-switch L_PLAIN)

  ;; TAP HOLD
  esc_sft       (tap-hold $tap_timeout $hold_timeout esc lsft)

  ;; ONE SHOT
  os_cw         (caps-word 1500)

  ;; MODIFIERS
  os_sft        (one-shot-press $one_shot_timeout lsft)
  os_ctl        (one-shot-press $one_shot_timeout lctl)
  os_alt        (one-shot-press $one_shot_timeout lalt)
  os_sup        (one-shot-press $one_shot_timeout lmet)
  os_ctl_sft    (one-shot-press $one_shot_timeout C-lsft)
  os_alt_sft    (one-shot-press $one_shot_timeout A-lsft)
  os_ctl_alt    (one-shot-press $one_shot_timeout C-lalt)
  os_sup_sft    (one-shot-press $one_shot_timeout M-lsft)
  os_sup_ctl    (one-shot-press $one_shot_timeout M-lctl)
  os_sup_alt    (one-shot-press $one_shot_timeout M-lalt)
  os_meh        (one-shot-press $one_shot_timeout C-A-lsft)

  ;; PLAIN
  pl_sil      (chord CH_PL ch_sil)
  pl_sir      (chord CH_PL ch_sir)

  ;; ALPHA
  al_sil      (chord CH_AL ch_sil)
  al_hil      (chord CH_AL ch_hil)
  al_hml      (chord CH_AL ch_hml)
  al_hrl      (chord CH_AL ch_hrl)
  al_hpl      (chord CH_AL ch_hpl)
  al_til      (chord CH_AL ch_til)
  al_tml      (chord CH_AL ch_tml)
  al_trl      (chord CH_AL ch_trl)
  al_tpl      (chord CH_AL ch_tpl)
  al_bil      (chord CH_AL ch_bil)
  al_bml      (chord CH_AL ch_bml)
  al_brl      (chord CH_AL ch_brl)
  al_bpl      (chord CH_AL ch_bpl)
  al_sir      (chord CH_AL ch_sir)
  al_hir      (chord CH_AL ch_hir)
  al_hmr      (chord CH_AL ch_hmr)
  al_hrr      (chord CH_AL ch_hrr)
  al_hpr      (chord CH_AL ch_hpr)
  al_tir      (chord CH_AL ch_tir)
  al_tmr      (chord CH_AL ch_tmr)
  al_trr      (chord CH_AL ch_trr)
  al_tpr      (chord CH_AL ch_tpr)
  al_bir      (chord CH_AL ch_bir)
  al_bmr      (chord CH_AL ch_bmr)
  al_brr      (chord CH_AL ch_brr)
  al_bpr      (chord CH_AL ch_bpr)
)

(defchords CH_PL $chord_timeout
  (ch_sil) g
  (ch_sir) h

  (ch_sil ch_sir) @sw_al
)

(defchords CH_AL $chord_timeout
  ;; LEFT
                (ch_tpl) q            (ch_trl) w    (ch_tml) e    (ch_til) r
                (ch_hpl) @al_nav_a    (ch_hrl) s    (ch_hml) d    (ch_hil) f    (ch_sil) g
                (ch_bpl) z            (ch_brl) x    (ch_bml) c    (ch_bil) v

  ;; RIGHT
                (ch_tir) u    (ch_tmr) i    (ch_trr) o    (ch_tpr) p
  (ch_sir) h    (ch_hir) j    (ch_hmr) k    (ch_hrr) l    (ch_hpr) @al_nav_semicolon
                (ch_bir) m    (ch_bmr) ,    (ch_brr) .    (ch_bpr) /

  ;;----------------------------------------------------------------------
  ;;                  | | | | |
  ;;                  |f|*|*|j|
  (ch_sil ch_sir) @sw_plain

  ;;----------------------------------------------------------------------
  ;;                  | | | | |     --     | | | | |
  ;;                  | |*|*|*|     --     |*|*|*| |
  (ch_hrl ch_hml ch_hil) spc               (ch_hir ch_hmr ch_hrr) spc

  ;;                  | |*|*|*|     --     |*|*|*| |
  ;;                  | | | | |     --     | | | | |
  (ch_trl ch_tml ch_til) @os_go            (ch_tir ch_tmr ch_trr) @os_go

  ;;                  | |*|*| |     --     | |*|*| |
  ;;                  | | | |*|     --     |*| | | |
  (ch_trl ch_tml ch_hil) @os_nums          (ch_hir ch_tmr ch_trr) @os_nums

  ;;                  | | |*| |     --     | |*| | |
  ;;                  | |*| |*|     --     |*| |*| |
  (ch_hrl ch_tml ch_hil) @os_media         (ch_hir ch_tmr ch_hrr) @os_media

  ;;                  | | |*|*|     --     |*|*| | |
  ;;                  | |*| | |     --     | | |*| |
  (ch_hrl ch_tml ch_til) @os_ff            (ch_tir ch_tmr ch_hrr) @os_ff

  ;;                  | |*| | |     --     | | |*| |
  ;;                  | | |*|*|     --     |*|*| | |
  (ch_trl ch_hml ch_hil) @os_cw            (ch_hir ch_hmr ch_trr) @os_cw

  ;;                  | | | |*|     --     |*| | | |
  ;;                  | |*|*| |     --     | |*|*| |
  ;;(ch_hrl ch_hml ch_til) ???               (ch_tir ch_hmr ch_hrr) ???

  ;;----------------------------------------------------------------------
  ;;                   | | | | |    --     | | | | |
  ;;                   | |*| | |    --     | | |*| |
  ;;                       | |*|    --     |*| |
  (ch_bil ch_hrl) @os_ctl                  (ch_bir ch_hrr) @os_ctl

  ;;                   | | | | |    --     | | | | |
  ;;                   | | |*| |    --     | |*| | |
  ;;                       | |*|    --     |*| |
  (ch_bil ch_hml) @os_sft                  (ch_bir ch_hmr) @os_sft

  ;;                   | | | | |    --     | | | | |
  ;;                   |*| | | |    --     | | | |*|
  ;;                       | |*|    --     |*| |
  (ch_bil ch_hpl) @os_alt                  (ch_bir ch_hpr) @os_alt

  ;;                   | | | | |    --     | | | | |
  ;;                   | | | | |    --     | | | | |
  ;;                       |*|*|    --     |*|*|
  (ch_bil ch_bml) @os_sup                  (ch_bir ch_bmr) @os_sup

  ;;                   | | | | |    --     | | | | |
  ;;                   | |*| | |    --     | | |*| |
  ;;                       |*| |    --     | |*|
  (ch_bml ch_hrl) @os_ch                   (ch_bmr ch_hrr) @os_ch

  ;;                   | | | | |    --     | | | | |
  ;;                   | |*|*| |    --     | |*|*| |
  ;;                       | |*|    --     |*| |
  (ch_bil ch_hml ch_hrl) @os_meh           (ch_bir ch_hmr ch_hrr) @os_meh

  ;;                   | | | | |    --     | | | | |
  ;;                   | |*| | |    --     | | |*| |
  ;;                       |*|*|    --     |*|*|
  ;;(ch_bil ch_bml ch_hrl) ???             (ch_bir ch_bmr ch_hrr) ???
)

;; Chords: "g + h" switchs to "L_PLAIN" (same layer with no modifiers - same combo to switch back)
(deflayermap (L_ALPHA)
  caps @esc_sft

  ;; LEFT
  q @al_tpl    w @al_trl     e @al_tml     r @al_til
  a @al_hpl    s @al_hrl     d @al_hml     f @al_hil    g @al_sil
  z @al_bpl    x @al_brl     c @al_bml     v @al_bil

  ;; RIGHT
               u @al_tir    i @al_tmr     o @al_trr     p @al_tpr
  h @al_sir    j @al_hir    k @al_hmr     l @al_hrr     ; @al_hpr
               m @al_bir    , @al_bmr     . @al_brr     / @al_bpr
)

;; Layer: no modifiers (ideal for gaming)
;; Chords: "g + h" to switch to "L_ALPHA"
(deflayermap (L_PLAIN)
  caps @esc_sft

  ;; LEFT
               q q     w w     e e     r r
               a a     s s     d d     f f    g @pl_sil
               z XX    x XX    c XX    v XX

  ;; RIGHT
               u u     i i     o o     p p
  h @pl_sir    j j     k k     l l     ; ;
               m XX    , XX    . XX    / XX
)

(deflayermap (L_CHARS) ;; Characters via compose key (ralt)
  ;; Compose + ' + vowel = accented vowel
  ;; Compose + ~ + n = ñ
  ;; Compose + " + u = ü
  ;; Shift variants produce uppercase automatically (compose handles it)

  a (macro ralt 20 ' 20 a)
  e (macro ralt 20 ' 20 e)
  i (macro ralt 20 ' 20 i)
  o (macro ralt 20 ' 20 o)
  u (macro ralt 20 ' 20 u)
  n (macro ralt 20 S-grv 20 n)         ;; ~ then n = ñ
  ;; ü via Shift+' (which is ") then u
  d (macro ralt 20 S-' 20 u)           ;; d for diaeresis: ü
)
