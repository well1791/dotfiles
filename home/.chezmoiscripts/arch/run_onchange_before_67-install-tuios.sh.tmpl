{{ template "install-header.sh.tmpl" . }}
# Install TUIOS (terminal multiplexer and window manager)
# https://tuios.dev/docs/getting-started

if log_version tuios; then
    exit 0
fi

AUR_HELPER=""
if check_command paru; then
    AUR_HELPER="paru"
elif check_command yay; then
    AUR_HELPER="yay"
else
    die "No AUR helper found (paru or yay required for CachyOS/Arch)"
fi

log_info "Installing TUIOS..."
if ! is_dry_run; then
    $AUR_HELPER -S --needed --noconfirm tuios-bin
else
    log_info "[DRY RUN] Would run: $AUR_HELPER -S --needed --noconfirm tuios-bin"
fi

if ! check_command tuios; then
    die "TUIOS installation failed"
fi

log_success "TUIOS installed" "$(get_version tuios)"
