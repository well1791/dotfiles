{{/* Distro-specific script exclusions */}}
{{/* Arch-family: cachyos, arch, manjaro, endeavouros */}}
{{ if not (eq .distro "cachyos" "arch" "manjaro" "endeavouros") }}
.chezmoiscripts/arch/**
{{ end }}

{{ if not (eq .distro "ubuntu" "debian" "linuxmint" "pop") }}
.chezmoiscripts/debian/**
{{ end }}

{{ if not (eq .distro "fedora" "rhel" "centos" "rocky" "almalinux") }}
.chezmoiscripts/fedora/**
{{ end }}

{{/* Headless machines don't need GUI configs */}}
{{ if .headless }}
.config/ghostty
.config/ghostty/**
.config/kanata
.config/kanata/**
.config/espanso
.config/espanso/**
.config/zellij
.config/zellij/**
.local/bin/run-or-cycle.sh
.local/bin/librewolf-profile-launch.sh
.local/bin/hxe
.local/share/applications/neo.desktop
.chezmoiscripts/arch/run_onchange_before_80-install-fuse2.sh.tmpl
.chezmoiscripts/arch/run_onchange_before_81-install-helium-browser.sh.tmpl
{{ end }}

{{/* Ephemeral machines get minimal config */}}
{{ if .ephemeral }}
.config/helix
.config/helix/**
.config/navi
.config/navi/**
.doom.d
.doom.d/**
.chezmoiscripts/run_onchange_before_74a-install-laya.sh.tmpl
.chezmoiscripts/run_onchange_after_74a-enable-laya.sh.tmpl
.config/systemd/user/laya.service
.local/share/laya/server.py
.local/share/applications/neo.desktop
.chezmoiscripts/arch/run_onchange_before_80-install-fuse2.sh.tmpl
{{ end }}

{{/* pi auto-loads every .ts/.js in ~/.pi/agent/extensions (loader isExtensionFile);
     colocated extension tests must stay in source only — deployed they would be
     loaded as extensions and fail on their bun:test import */}}
.pi/agent/extensions/laya-model-router.test.ts
