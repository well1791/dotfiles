{
  "providers": {
    "llamacpp": {
      "baseUrl": "http://localhost:8081/v1",
      "api": "openai-completions",
      "apiKey": "llamacpp",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false
      },
      "models": [
        {
          "id": "minicpm5-2b",
          "name": "MiniCPM5 2B (Local llama.cpp)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 73728,
          "maxTokens": 8192,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    },
    "github-copilot": {
      "modelOverrides": {
        "claude-sonnet-4.5": {
          "cost": {
            "input": 3,
            "output": 15
          }
        },
        "claude-opus-4.6": {
          "cost": {
            "input": 15,
            "output": 75
          }
        }
      }
    }
  }
}
