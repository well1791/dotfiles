[Desktop Entry]
Type=Application
Name=Helium - Work
GenericName=Web Browser (Work Profile)
Comment=Browse the web with the Helium work profile instance
Icon=helium-browser
Exec=helium-browser --user-data-dir={{ .chezmoi.homeDir }}/.config/helium-work --class=helium-work %U
Categories=Network;WebBrowser;
Keywords=web;browser;internet;helium;work;
Terminal=false
StartupNotify=true
StartupWMClass=helium-work
