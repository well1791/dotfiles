#!/bin/bash
# hxe - helix extensions launcher
# Launches tools in floating tuios popups with context from helix
set -e

if [ "$TUIOS_ENV" != "1" ]; then
  echo "hxe: not inside a tuios session (TUIOS_ENV unset)" >&2
  exit 1
fi

POPUP=(popup -s "$TUIOS_SESSION" --width 80% --height 80%)

bufdir() {
  local buf="${1/\~/$HOME}"
  if [ -n "$buf" ] && [ -e "$buf" ]; then
    dirname "$(realpath "$buf")"
  else
    printf '%s' "$PWD"
  fi
}

case "$1" in
  gitu)
    dir=$(bufdir "$2")
    tuios "${POPUP[@]}" --name "Git" --cwd "$dir" -- gitu
    ;;
  find-replace)
    dir=$(bufdir "$2")
    if git -C "$dir" rev-parse --is-inside-work-tree &>/dev/null; then
      root=$(git -C "$dir" rev-parse --show-toplevel)
      tuios "${POPUP[@]}" --name "Find & Replace" -- serpl -p "$root"
    else
      tuios "${POPUP[@]}" --name "Find & Replace" -- serpl
    fi
    ;;
  terminal)
    tuios "${POPUP[@]}" --name "Terminal" -- "${SHELL:-/bin/bash}"
    ;;
  *)
    echo "Usage: hxe {gitu|find-replace|terminal} [buffer_path]"
    exit 1
    ;;
esac
